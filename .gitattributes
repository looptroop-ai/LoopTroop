# eol=lf, not text=auto: text=auto normalises in the repository but still
# converts on checkout per platform, so every file below would arrive as CRLF on
# Windows and fail the repository's own line-ending policy test.
* text=auto eol=lf

*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ttf binary
*.woff binary
*.woff2 binary
