# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
site/
# `npm pack` output. The Docker build expects the tarball here, and the install
# smoke test packs one on every run, so without this a 3.6 MB artefact is one
# stray `git add` away from the history.
looptroop-*.tgz
# The bundle the managed package channels install, built into the checkout by
# scripts/build-bundle.mjs the same way `npm pack` writes its tarball here.
looptroop-*-bundle.tar.gz
dist-bundle/

# Runtime/state for this app
.looptroop/
.looptroop-test-config/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# TypeScript
*.tsbuildinfo

# Coverage and test output
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files
.env
.env.*
!.env.example

# Temp files
tmp/
temp/

# OS/editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
.kilo/
.codex


# Agent/tool local state
.agent/
.agents/
.antigravitycli/
.claude/
.cursor/
.windsurfer/
.roomodes
*.aider*
*.bak
# Removed repository metadata
/CITATION.cff
AGENTS.md
CLAUDE.md
GEMINI.md

# Backup files
*.orig.tsx
*.orig.ts

# Database files
*.db
*.db-journal
*.sqlite3

# Cache and testing
.eslintcache
.vite/
.vitest-cache/
playwright-report/
test-results/
.playwright/
.cache/
docs/.vitepress/cache/
docs/.vitepress/dist/
docs/.vitepress/.temp/


# Written by the Homebrew/Scoop/Chocolatey installers at the package root;
# a local copy would make a checkout report the wrong install channel.
.install-channel
