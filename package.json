{
  "name": "looptroop",
  "version": "0.5.9",
  "description": "Local AI coding orchestration for repo-scale work: LLM-council planning, Ralph-loop recovery, isolated OpenCode worktrees, and human-gated PR delivery.",
  "type": "module",
  "keywords": [
    "ai-orchestration",
    "llm-orchestration",
    "agent-orchestration",
    "multi-agent-orchestration",
    "multi-agent-systems",
    "ai-agents",
    "agentic-ai",
    "agentic-coding",
    "agentic-workflow",
    "coding-agent",
    "ai-coding",
    "ai-code-generation",
    "llm-council",
    "ralph-loop",
    "opencode",
    "git-worktree",
    "human-in-the-loop",
    "developer-tools",
    "typescript",
    "sqlite"
  ],
  "author": "LoopTroop AI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/looptroop-ai/LoopTroop.git"
  },
  "bugs": {
    "url": "https://github.com/looptroop-ai/LoopTroop/issues"
  },
  "homepage": "https://www.looptroop.ovh/",
  "engines": {
    "node": ">=24.18.0"
  },
  "main": "dist/server/index.js",
  "bin": {
    "looptroop": "dist/server/cli/launcher.cjs"
  },
  "files": [
    "dist/",
    "!dist/client/bundled-packages.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "packageManager": "npm@12.0.2",
  "scripts": {
    "predev": "node scripts/dev-preflight.mjs",
    "dev": "tsx scripts/dev.ts",
    "dev:app": "concurrently -n fe,be -c blue,green \"npm:dev:frontend\" \"npm:dev:backend\"",
    "deps:sync": "tsx scripts/dev-deps.ts",
    "audit:remediate": "tsx scripts/dev-audit.ts",
    "opencode:upgrade": "tsx scripts/dev-opencode-upgrade.ts",
    "dev:opencode": "tsx scripts/dev-opencode.ts",
    "dev:frontend": "vite",
    "dev:frontend:preview": "vite build && vite preview",
    "dev:backend": "tsx scripts/dev-backend.ts",
    "diagnose:stall": "tsx scripts/diagnose-runtime-stall.ts",
    "verify:no-native-addons": "node scripts/verify-no-native-addons.mjs",
    "verify:version": "node scripts/verify-version-single-source.mjs",
    "verify:strip-types": "node scripts/verify-strip-types.mjs",
    "verify:package": "node scripts/verify-package-contents.mjs",
    "verify:install": "node scripts/smoke-install.mjs",
    "verify:installer": "node scripts/smoke-installer.mjs",
    "verify:published": "node scripts/smoke-published.mjs",
    "verify:bundle": "node scripts/smoke-bundle.mjs",
    "installers:sync": "node scripts/sync-installers.mjs",
    "installers:check": "node scripts/sync-installers.mjs --check",
    "build:bundle": "node scripts/build-bundle.mjs",
    "verify:container": "node scripts/smoke-container.mjs",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "licenses:check": "node scripts/generate-third-party-notices.mjs --check",
    "release:notes": "node scripts/print-release-notes.ts",
    "release:bump": "node scripts/release-bump.ts",
    "release:detect": "node scripts/release-detect.ts",
    "release:manifest": "node scripts/release-manifest.ts",
    "release:verify-artifact": "node scripts/release-verify-artifact.ts",
    "prepublishOnly": "npm run build && npm run licenses:check && npm run verify:package",
    "build": "tsc -b && npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:client": "vitest run --project client-dom --project client-node",
    "test:server": "vitest run --project server-pure --project server-integration",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate --config=server/db/app.config.ts",
    "db:generate:app": "drizzle-kit generate --config=server/db/app.config.ts",
    "db:generate:project": "drizzle-kit generate --config=server/db/project.config.ts",
    "db:push": "drizzle-kit push --config=server/db/app.config.ts",
    "db:push:app": "drizzle-kit push --config=server/db/app.config.ts",
    "db:push:project": "drizzle-kit push --config=server/db/project.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@opencode-ai/sdk": "^1.18.31",
    "drizzle-orm": "1.0.0-rc.4",
    "gpt-tokenizer": "^4.0.0",
    "hono": "^4.13.8",
    "js-yaml": "^5.4.2",
    "xstate": "^5.33.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@eslint/js": "^10.0.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.103.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "1.0.0-rc.4",
    "esbuild": "0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-check": "4.10.2",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "lucide-react": "^1.47.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-virtuoso": "^4.18.13",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "ts-morph": "^28.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "//allowScripts": "Security decisions and scoped exceptions: .github/security-alert-dispositions.md",
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": false
  }
}
