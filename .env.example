# Runtime mode used by the backend and shared config helpers.
NODE_ENV=development

# Optional override for the LoopTroop config directory.
# Defaults to %APPDATA%\looptroop on Windows and
# $XDG_CONFIG_HOME/looptroop (or ~/.config/looptroop) elsewhere.
# LOOPTROOP_CONFIG_DIR=/absolute/path/to/config

# Optional override for the main app SQLite database path.
# Defaults to <config dir>/app.sqlite
# LOOPTROOP_APP_DB_PATH=/absolute/path/to/app.sqlite

# Frontend dev server port. When LOOPTROOP_FRONTEND_ORIGIN is unset, the
# default frontend origin is derived as http://localhost:<this port>.
LOOPTROOP_FRONTEND_PORT=5173

# Optional explicit frontend origin exposed to the backend and app links.
# Invalid values fall back to the default derived from LOOPTROOP_FRONTEND_PORT.
# LOOPTROOP_FRONTEND_ORIGIN=http://localhost:5173

# Docs dev server port. Only used when LOOPTROOP_DEV_DOCS=1.
LOOPTROOP_DOCS_PORT=5174

# Set to 1 to run a local VitePress docs server as part of `npm run dev`.
# LOOPTROOP_DEV_DOCS=1

# Docs origin exposed to the frontend. Defaults to the hosted documentation
# site; point it at http://localhost:5174 when serving docs locally.
# LOOPTROOP_DOCS_ORIGIN=http://localhost:5174

# Backend API host and port. The host defaults to loopback; non-loopback hosts
# require LOOPTROOP_ALLOW_REMOTE_API=1 and LOOPTROOP_API_TOKEN to be set.
# LOOPTROOP_BACKEND_HOST=127.0.0.1
LOOPTROOP_BACKEND_PORT=3000

# Set to 1 only when the backend is behind a trusted reverse proxy and you want
# to expose the control-plane API beyond loopback. Requires LOOPTROOP_API_TOKEN.
# LOOPTROOP_ALLOW_REMOTE_API=0

# Set to 1 only for local troubleshooting when LOOPTROOP_API_TOKEN is unset.
# Has no effect when a token is configured; non-loopback binds still require a token.
# LOOPTROOP_ALLOW_UNAUTHENTICATED=0

# Optional API token for /api/* routes. Normal API requests authenticate with
# X-LoopTroop-Token or Authorization: Bearer. Browser EventSource clients may use
# apiToken only on /api/stream. npm run dev generates an ephemeral token when
# this is unset and the Vite dev proxy injects it server-side.
# LOOPTROOP_API_TOKEN=

# Set to 1 only when the backend is behind a trusted proxy that owns
# x-forwarded-for/x-real-ip.
LOOPTROOP_TRUST_PROXY=0

# Disabled by default. Enables the development-only state-machine event route
# when paired with a strong LOOPTROOP_DEV_EVENT_TOKEN.
LOOPTROOP_ENABLE_DEV_EVENT=0
# LOOPTROOP_DEV_EVENT_TOKEN=

# Base URL for the OpenCode server or compatible endpoint.
LOOPTROOP_OPENCODE_BASE_URL=http://127.0.0.1:4096

# Set to mock to use the in-process OpenCode mock adapter.
LOOPTROOP_OPENCODE_MODE=

# Optional OpenCode log directory for enriching generic provider errors from an external server.
# LOOPTROOP_OPENCODE_LOG_DIR=

# Set to inherit to leave any existing OpenCode permission environment untouched.
# By default npm run dev sets OPENCODE_PERMISSION='"allow"' for the managed server.
# LOOPTROOP_OPENCODE_PERMISSION_MODE=

# Direct watcher fallback for npm run dev:opencode. Set to all to start a managed
# OpenCode server with --print-logs --log-level DEBUG when the watcher launches it.
# LOOPTROOP_OPENCODE_LOGS=

# Optional basic-auth username for the OpenCode dev server.
OPENCODE_SERVER_USERNAME=opencode

# Optional basic-auth password for the OpenCode dev server.
# OPENCODE_SERVER_PASSWORD=change-me

# Set to 1 to skip automatic dependency sync and npm audit remediation during npm run dev.
# Opt in to daily dependency sync, audit remediation and OpenCode CLI upgrade
# during `npm run dev`. Skipped by default: these rewrite package.json, the
# lockfile, or a globally installed CLI. Run them explicitly instead with
# `npm run deps:sync`, `npm run audit:remediate`, `npm run opencode:upgrade`.
# LOOPTROOP_DEV_MAINTENANCE=1
LOOPTROOP_DEV_SKIP_DEPS=0

# Set to 1 to skip automatic OpenCode CLI upgrades during npm run dev.
LOOPTROOP_DEV_SKIP_OPENCODE_UPGRADE=0

# Set to 1 to bypass the once-per-day maintenance gate and force all startup maintenance now.
LOOPTROOP_DEV_FORCE_MAINTENANCE=0

# Direct watcher fallback for LAN sharing. Set to 1, true, 0.0.0.0, or a specific
# host/IP when not launching through npm run dev --lan.
# LOOPTROOP_DEV_HOST=

# Optional project database target for Drizzle project DB commands.
# LOOPTROOP_PROJECT_DB_PATH=.looptroop/db.sqlite

# Set to 1 to silence test-only console output.
LOOPTROOP_TEST_SILENT=0

# Optional file-watching override for the frontend and backend watchers.
# Leave unset for auto-detection (native watching everywhere except WSL on a
# Windows-mounted drive). Set to 1 to force polling, 0 to force native watching.
CHOKIDAR_USEPOLLING=0

# Vitest sets this automatically during tests.
# VITEST=1

# Optional XDG config base directory used when LOOPTROOP_CONFIG_DIR is unset.
# XDG_CONFIG_HOME=/home/you/.config

# WSL detection hint that is usually provided by the shell.
# WSL_DISTRO_NAME=Ubuntu

# Additional WSL detection hint that is usually provided by the shell.
# WSL_INTEROP=/run/WSL/123_interop

# Standard shell home directory used by diagnostics and default config resolution.
# HOME=/home/you

# Disable ANSI colors in diagnostic script output.
# NO_COLOR=1

# Force ANSI colors in diagnostic script output.
# FORCE_COLOR=1
